[global]
follow = mouse
indicate_hidden = yes


origin = top-right
offset = 20x20
width = 380
notification_height = 110
notification_limit = 6
gap_size = 12


transparency = 0
corner_radius = 18
frame_width = 2
separator_height = 1

background = "#00000080"
foreground = "#ffffff"

padding = 18
horizontal_padding = 18
text_icon_padding = 14


font = Orbitron SemiBold 10
line_height = 4


sort = yes
idle_threshold = 120
markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
word_wrap = yes
ellipsize = middle
stack_duplicates = true
hide_duplicate_count = false
show_indicators = yes


min_icon_size = 32
max_icon_size = 64
icon_corner_radius = 12
icon_position = left

icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/:/usr/share/icons/Papirus-Dark/16x16/actions/:/usr/share/icons/Papirus-Dark/16x16/animations/:/usr/share/icons/Papirus-Dark/16x16/apps/:/usr/share/icons/Papirus-Dark/16x16/categories/:/usr/share/icons/Papirus-Dark/16x16/emblems/:/usr/share/icons/Papirus-Dark/16x16/emotes/:/usr/share/icons/Papirus-Dark/16x16/mimetypes/:/usr/share/icons/Papirus-Dark/16x16/panel/:/usr/share/icons/Papirus-Dark/16x16/places/


dmenu = rofi -dmenu -p dunst:
browser = xdg-open

title = Dunst
class = Dunst

timeout = 6


progress_bar = true
progress_bar_height = 6
progress_bar_frame_width = 0
progress_bar_corner_radius = 4


mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
timeout = 3

[urgency_normal]
timeout = 6

[urgency_critical]
frame_width = 3
timeout = 0
